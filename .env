# GSM-Bot Generic Configuration

# --- Game Server Settings ---
# The Docker image for the game (e.g., itzg/minecraft-server, pepecitron/projectzomboid-server)
GAME_IMAGE=pepecitron/projectzomboid-server

# The internal path where the game saves its data/config
# Zomboid: /data, Minecraft: /data, Valheim: /config
GAME_INTERNAL_DATA_PATH=/data

# Ports to expose (format: host_port:container_port/protocol)
# Note: For multiple ports, you may need to edit docker-compose.yml directly if more than 2 are needed.
GAME_PORT_1=16261:16261/udp
GAME_PORT_2=16262:16262/udp

# --- Backup Settings ---
BACKUP_INTERVAL_HOURS=5
BACKUP_RETENTION_DAYS=3
RCLONE_REMOTE_NAME=gdrive
ENABLE_CLOUD_BACKUP=false
